# ==============================================================================
# yoga-frontend — environment variable reference
# Copy this file to .env.local (or .env) and fill in values before running.
# All variables MUST be prefixed NEXT_PUBLIC_ to be available in the browser.
# Lines marked [REQUIRED] must be set or the app will not function correctly.
# Lines marked [OPTIONAL] have safe defaults for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# API & WebSocket  [REQUIRED]
# ------------------------------------------------------------------------------
# Base URL for all REST API calls (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket base URL for real-time chat (no trailing slash, no /ws path suffix)
NEXT_PUBLIC_SOCKET_BASE_URL=ws://localhost:8000/ws

# ------------------------------------------------------------------------------
# App URL & Environment  [REQUIRED]
# ------------------------------------------------------------------------------
# Public-facing URL of this Next.js app (used in redirect URLs, canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 'development' to unlock dev-only features (country gate bypass, etc.)
# Set to 'production' in production deployments
NEXT_PUBLIC_APP_ENVRONMENT=development

# ------------------------------------------------------------------------------
# Stripe  [REQUIRED]
# Use publishable key only (never the secret key on the frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ------------------------------------------------------------------------------
# Zoom  [REQUIRED for group coaching / live session features]
# Must match the values in yoga-backend .env
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ZOOM_CLIENT_ID=your_zoom_client_id
NEXT_PUBLIC_ZOOM_CLIENT_SECRET=your_zoom_client_secret
